% preprint.sty — single-column preprint layout matching the NeurIPS/ICML dress.
%
% NOTE ON PROVENANCE: the official NeurIPS and ICML style files are distributed with each
% venue's call for papers and are not on CTAN, so they cannot be fetched by a self-contained
% engine. This file reproduces the NeurIPS single-column preprint geometry and typography
% (US Letter, 5.5in x 9in text block, 10pt Times, run-in bold subsubsections). At submission,
% drop in the official .sty and delete this file — no document body changes are required.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preprint}[2026/08/09 single-column preprint layout]

\RequirePackage[letterpaper,left=1.5in,right=1.5in,top=1.0in,bottom=1.0in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{newtxtext}
\let\Bbbk\relax          % newtxmath and amssymb both define it; amssymb wins, loaded first
\RequirePackage{newtxmath}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage[font=small,labelfont=bf,skip=6pt]{caption}
\RequirePackage{natbib}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage[capitalise,noabbrev]{cleveref}

% ---- palette, shared with the figures (Paul Tol, colourblind-safe) ------------------------
\definecolor{tolblue}{HTML}{4477AA}
\definecolor{tololive}{HTML}{999933}
\definecolor{tolred}{HTML}{CC3311}
\definecolor{tolgrey}{HTML}{666666}

\hypersetup{colorlinks=true, linkcolor=tolblue, citecolor=tolblue, urlcolor=tolblue}

% ---- float placement -----------------------------------------------------------------------
% This paper is figure-dense and several sections are currently stubs, so the default limits
% (2 top floats, 3 total, 70% of a page) defer figures past their own sections.
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.60}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.60}

% ---- vertical rhythm ---------------------------------------------------------------------
\setlength{\parskip}{0pt}
\setlength{\parindent}{12pt}
\renewcommand{\baselinestretch}{1.0}
\setlength{\abovedisplayskip}{7pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{7pt plus 2pt minus 2pt}

\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.6ex \@minus -.2ex}{1.3ex \@plus.2ex}{\normalfont\large\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.7ex \@plus -0.5ex \@minus -.2ex}{1.0ex \@plus.2ex}{\normalfont\normalsize\bfseries}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.4ex \@plus -0.4ex \@minus -.2ex}{-0.7em}{\normalfont\normalsize\bfseries}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.2ex \@plus .3ex \@minus .2ex}{-0.6em}{\normalfont\normalsize\bfseries}}

% ---- title block -------------------------------------------------------------------------
\renewcommand{\maketitle}{%
  \begingroup
  \begin{center}
    {\Large\bfseries \@title \par}
    \vskip 1.4em
    {\normalsize \@author \par}
    \vskip 0.4em
    {\small\color{tolgrey} \@date \par}
  \end{center}
  \vskip 1.2em
  \endgroup}

\renewenvironment{abstract}{%
  \vskip 0.2em
  \begin{center}{\bfseries Abstract}\end{center}
  \begin{list}{}{\setlength{\leftmargin}{0.30in}\setlength{\rightmargin}{0.30in}}\item[]\small}
  {\end{list}\vskip 0.8em}

% ---- shared macros -----------------------------------------------------------------------
% Placeholder for any quantity that does not exist until the pre-registered run completes.
% Every one of these is a hard blocker on submission; none may be filled by estimate.
\newcommand{\TBD}[1]{{\color{tolred}\textbf{[#1]}}}
% Every placeholder VALUE appearing in prose or a caption carries this marker, so that no reader
% of any draft can mistake a fabricated number for a measured one. Placeholder DATA inside figures
% is additionally required to be implausible by construction -- see the figure scripts.
\newcommand{\PH}[1]{{\color{tolred}\textbf{[PH: #1]}}}
\newcommand{\IR}{\mathrm{IR}}
\newcommand{\bpt}{\mathrm{bpt}}
\newcommand{\TFI}{\mathrm{TFI}}
\newcommand{\stateSym}{s}

\endinput
